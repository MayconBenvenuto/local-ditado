{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Ditado",
  "version": "0.2.0",
  "identifier": "com.localditado.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Local Ditado",
        "width": 940,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Ditado offline com Whisper local",
    "longDescription": "Ditado por voz 100% offline e privado, com Whisper local, atalho global e suporte a Windows, Linux e macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/local-ditado-engine/**/*"]
  }
}
